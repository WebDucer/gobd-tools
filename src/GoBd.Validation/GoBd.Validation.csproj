<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>GoBd.Validation</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <!-- Enforced by Directory.Build.targets: no path to the native store, direct or transitive. -->
    <ForbidsNativeStore>true</ForbidsNativeStore>
  </PropertyGroup>

  <ItemGroup>
    <!-- The mask and scalar rules are intricate enough to deserve direct tests without
         widening the library's public surface for them. -->
    <InternalsVisibleTo Include="GoBd.Validation.Tests" />
    <!-- The store expresses the same rules in SQL, and a rule both engines apply has to be
         stated in one place rather than written down twice and hoped to match. -->
    <InternalsVisibleTo Include="GoBd.Reader.Data" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\gdpdu-01-03-2019.dtd" LogicalName="GoBd.Validation.gdpdu-01-03-2019.dtd" />
  </ItemGroup>

  <!-- The licence, what it does not cover, and the notices of every component the builds contain.
       Both tools carry them inside themselves, because each is delivered as one file with nothing
       beside it, and both reference this library. See the prepare-public-release change's
       design.md D2. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="GoBd.LICENSE" Visible="false" />
    <EmbeddedResource Include="..\..\NOTICE" LogicalName="GoBd.NOTICE" Visible="false" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="GoBd.THIRD-PARTY-NOTICES.txt" Visible="false" />
  </ItemGroup>

</Project>
